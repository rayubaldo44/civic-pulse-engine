# ── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (Settings → API → Project URL)
SUPABASE_URL="https://<your-project-ref>.supabase.co"
PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Anon / public key — safe to expose in client-side code (Settings → API → anon public)
PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Service role key — server-side only, bypasses Row-Level Security. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ── Facebook Graph API ────────────────────────────────────────────────────────
# Long-lived Page Access Token (Facebook Developer Console → your app → Graph API Explorer)
FB_PAGE_ACCESS_TOKEN="EAAA..."

# Facebook Page ID (numeric)
FB_PAGE_ID="000000000000000"

# App credentials (Facebook Developer Console → your app → Settings → Basic)
FB_APP_ID="000000000000000"
FB_APP_SECRET="<32-char hex secret>"

# Graph API version to use (e.g. v25.0)
GRAPH_API_VERSION="v25.0"

# ── Database (Prisma / direct connections) ────────────────────────────────────
# Optional direct SQL tooling connection; the web app uses supabase-js
DATABASE_URL="postgresql://postgres.<your-project-ref>:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional direct SQL tooling connection; Prisma is not bundled
DIRECT_URL="postgresql://postgres.<your-project-ref>:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Supabase Edge Function secrets ───────────────────────────────────────────
# These are NOT set here — they must be added via:
#   supabase secrets set GROQ_API_KEY=<value>
#   supabase secrets set HF_SPACE_URL=<value>
#
# GROQ_API_KEY     — used by process-comment edge function for the RAG/LLM step
# HF_SPACE_URL     — URL of the HuggingFace NLP Space (e.g. https://ArthurOrg-civicpulse-nlp.hf.space)

# Collection scripts also read YOUTUBE_API_KEY. No live-data ingestion workflow
# is enabled in this public repository; CI uses synthetic configuration only.

# ── Email notifications (Resend) ──────────────────────────────────────────────
# Optional — without RESEND_API_KEY, issue emails are silently skipped (dev no-op).
# Get one at https://resend.com → API Keys → Create API Key
RESEND_API_KEY="re_your_api_key_here"

# Verified sender header. Requires verifying your sending domain in Resend
# (Domains → Add Domain) and copying its DNS records into your registrar
# (Namecheap → Domain List → Manage → Advanced DNS).
MAIL_FROM="Civic Pulse <no-reply@yourdomain.com>"

# Absolute origin used in email links. Falls back to VERCEL_URL, then localhost.
APP_ORIGIN="https://your-production-domain.com"

# Protects Vercel's daily issue-review reminder endpoint (16+ random characters).
CRON_SECRET="replace-with-a-long-random-secret"

# Set to true only for a separate synthetic showcase deployment. The server
# returns 404 for staff and API routes when enabled; never deploy it with
# production database or integration credentials.
DEMO_ONLY="false"
