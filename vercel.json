{
	"crons": [
		{
			"path": "/api/cron/issue-review-reminders",
			"schedule": "0 0 * * *"
		}
	],
	"headers": [
		{
			"source": "/img/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/fonts/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
